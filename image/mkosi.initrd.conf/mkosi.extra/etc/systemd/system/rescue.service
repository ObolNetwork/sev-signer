# Replaces the stock rescue.service: there is no shell in this image, so a
# boot failure powers the guest off instead of offering a login.
[Unit]
Description=Power off instead of rescue mode
DefaultDependencies=no
SuccessAction=poweroff-force
FailureAction=poweroff-force

[Service]
Type=oneshot
ExecStart=/usr/bin/echo "dvtee: boot failed, powering off (no rescue shell in this image)"
StandardOutput=journal+console
