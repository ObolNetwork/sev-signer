# The only network listener in the image: the signing API on 9000 and the
# public listener (health and attestation) on 9001. Runs as uid 0 because
# configfs-tsm report entries are root-owned, but with no capabilities and a
# read-only view of everything except its data dir and the TSM report dir.
[Unit]
Description=dvtee (Web3Signer-compatible eth2 BLS signer)
Requires=dvtee-provision.service
After=dvtee-provision.service network.target sys-kernel-config.mount systemd-modules-load.service
RequiresMountsFor=/var/lib/dvtee
StartLimitIntervalSec=10min
StartLimitBurst=5
FailureAction=poweroff-force

[Service]
Type=exec
ExecStart=/usr/lib/dvtee/start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

User=root
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
# No "-": if configfs-tsm is missing, fail loudly rather than serve without attestation.
ReadWritePaths=/var/lib/dvtee /sys/kernel/config/tsm/report
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
KeyringMode=private
RemoveIPC=yes
UMask=0077
LimitCORE=0

[Install]
WantedBy=multi-user.target
